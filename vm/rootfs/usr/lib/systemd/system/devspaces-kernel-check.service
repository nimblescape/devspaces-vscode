# The kernel check of the VM of Devspaces at each start of the VM
# (docs/requirements.md R-VM-003): it checks the running kernel only when its
# release changed since the last check, and writes the result to
# /var/lib/devspaces/kernel-check, which Devspaces reads.
[Unit]
Description=Devspaces: check the kernel options that Docker Engine requires

[Service]
Type=oneshot
ExecStart=/usr/lib/devspaces/kernel-check --record
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
