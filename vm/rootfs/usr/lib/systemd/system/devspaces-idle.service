# The idle check of the VM of Devspaces in Lima (docs/requirements.md
# R-VM-004): the VM powers off when the script idle ends, that is when
# nothing runs in it. In WSL, a hidden wsl.exe of Devspaces runs the script
# instead, and WSL stops the distribution when it ends.
[Unit]
Description=Devspaces: power the VM off when nothing runs in it
ConditionVirtualization=!wsl
After=docker.service

[Service]
Type=exec
ExecStart=/usr/lib/devspaces/idle
SuccessAction=poweroff
Restart=on-failure
RestartSec=1min

[Install]
WantedBy=multi-user.target
