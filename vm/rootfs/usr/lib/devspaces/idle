# The idle check of the VM of Devspaces (docs/requirements.md R-VM-004): the
# script ends when nothing runs in the VM, at two checks in a row, one minute
# apart. The first check is one minute after the start of the script, so that
# whoever started the VM has the time to start a container. The same script
# runs in WSL and in Lima: in WSL, one hidden wsl.exe of Devspaces runs it,
# and WSL stops the distribution when it ends; in Lima, the service
# devspaces-idle runs it and powers the VM off when it ends.
#
# Something runs while
#   - the package upgrade of the VM runs (the service devspaces-upgrade), so
#     that the VM never stops in the middle of dpkg,
#   - Docker Engine starts or stops,
#   - a container runs: a devspace, the Monitor, a worker, a build container,
#   - or a program talks to Docker Engine, for example while it downloads an
#     image for a devspace that has no container yet.
set -u

interval=60

# Whether something runs (exit status 0).
busy() {
  case "$(systemctl show --property=ActiveState --value devspaces-upgrade.service 2>/dev/null)" in
    active|activating|deactivating|reloading|refreshing) return 0 ;;
  esac
  case "$(systemctl show --property=ActiveState --value docker.service 2>/dev/null)" in
    active) ;;
    activating|deactivating|reloading|refreshing) return 0 ;;
    # Docker does not run (inactive, failed): no container runs.
    *) return 1 ;;
  esac
  # A program connected to the socket of Docker Engine: the table of the Unix
  # sockets has a connected one (state 03) at the path of that socket.
  if awk '$6 == "03" && ($8 == "/run/docker.sock" || $8 == "/var/run/docker.sock") { found = 1 } END { exit !found }' /proc/net/unix; then
    return 0
  fi
  # A running container. Docker that does not answer counts as busy.
  ids=$(timeout 30 docker ps --quiet 2>/dev/null) || return 0
  [ -n "$ids" ]
}

idle=0
while :; do
  sleep "$interval"
  if busy; then
    idle=0
  else
    idle=$((idle + 1))
  fi
  if [ "$idle" -ge 2 ]; then
    echo "Nothing runs in the VM of Devspaces: it stops."
    exit 0
  fi
done
